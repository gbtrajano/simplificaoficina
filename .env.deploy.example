# SOMENTE PARA PUBLICAR O BACKEND. Nunca envie este arquivo para clientes.
# Copie para .env.deploy.local e substitua os valores abaixo.

# Supabase Dashboard > Project Settings > General > Reference ID.
# Pode deixar vazio: o script extrai automaticamente da VITE_SUPABASE_URL.
SUPABASE_PROJECT_REF=cole_o_reference_id_aqui

# Supabase Dashboard > ícone do perfil > Account Preferences > Access Tokens
# É um token pessoal da sua conta, normalmente começa com sbp_.
SUPABASE_ACCESS_TOKEN=cole_o_personal_access_token_aqui

# Senha definida quando o projeto foi criado.
# Se não lembrar: Project Settings > Database > Reset database password.
SUPABASE_DB_PASSWORD=cole_a_senha_do_banco_aqui

# Mercado Pago Developers > sua aplicação > Credenciais de produção
MP_ACCESS_TOKEN=cole_o_access_token_do_mercado_pago_aqui

# Mercado Pago > Webhooks > assinatura secreta da aplicação
MP_WEBHOOK_SECRET=cole_a_assinatura_secreta_do_webhook_aqui
